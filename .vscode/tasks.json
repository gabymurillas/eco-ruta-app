{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build debug APK",
      "type": "shell",
      "command": ".\\gradlew.bat assembleDebug",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gradle"]
    },
    {
      "label": "Install on device/emulator",
      "type": "shell",
      "command": ".\\gradlew.bat installDebug",
      "problemMatcher": ["$gradle"]
    },
    {
      "label": "Unit tests",
      "type": "shell",
      "command": ".\\gradlew.bat testDebugUnitTest",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": ["$gradle"]
    },
    {
      "label": "Lint",
      "type": "shell",
      "command": ".\\gradlew.bat lintDebug",
      "problemMatcher": ["$gradle"]
    },
    {
      "label": "Full check (tests + lint + release build)",
      "type": "shell",
      "command": ".\\gradlew.bat testDebugUnitTest lintDebug assembleRelease",
      "problemMatcher": ["$gradle"]
    },
    {
      "label": "Start emulator (Medium_Phone_API_36.1)",
      "type": "shell",
      "command": "& \"$env:LOCALAPPDATA\\Android\\Sdk\\emulator\\emulator.exe\" -avd Medium_Phone_API_36.1",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Logcat (app only)",
      "type": "shell",
      "command": "adb logcat --pid=$(adb shell pidof -s com.ecoruta.dispositivo)",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Launch app",
      "type": "shell",
      "command": "adb shell am start -n com.ecoruta.dispositivo/.presentation.MainActivity",
      "problemMatcher": []
    }
  ]
}
